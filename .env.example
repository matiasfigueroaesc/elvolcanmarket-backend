# Copiar como .env (el .env NO se sube a GitHub). Lo lee docker compose.
# En AWS cambia TODAS las contraseñas y la clave interna por valores propios.

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root_volcan
# Contraseña de los usuarios volcan_usuarios, volcan_catalogo, volcan_ventas y volcan_despacho
# (cada uno solo puede usar su base). Es la misma que usan por defecto los application-mysql.yml.
MYSQL_APP_PASSWORD=volcan123
# Puerto de MySQL en este computador (solo accesible desde localhost). Cambiar si el 3306 está ocupado.
MYSQL_PORT=3306

# ---- Microservicios ----
# Clave que ventas usa para pedirle al catálogo que descuente stock (mínimo 32 caracteres).
INTERNAL_API_KEY=local-cambiar-clave-interna-32-caracteres
# Contraseñas de los usuarios de prueba que crea el servicio usuarios la primera vez.
ADMIN_PASSWORD=admin1234
VENDEDOR_PASSWORD=vendedor1234
CLIENTE_PASSWORD=cliente1234
# Orígenes permitidos para CORS cuando el front corre con "npm run dev".
# (Con el front en Docker no hace falta: nginx y el Gateway quedan en la misma dirección.)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# false mientras no haya HTTPS (local y EC2 con http).
COOKIE_SECURE=false

# ---- Puertos publicados ----
GATEWAY_PORT=8080
WEB_PORT=80
# Carpeta del repo del frontend (para --profile web).
FRONTEND_DIR=../elvolcanmarket
