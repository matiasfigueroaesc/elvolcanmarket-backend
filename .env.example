# Copiar este archivo como .env (el .env NO se sube a GitHub).
# Solo lo usa docker compose (MySQL). Los microservicios con el perfil h2 no lo necesitan.
MYSQL_ROOT_PASSWORD=root_volcan
# Contraseña de los usuarios volcan_usuarios, volcan_catalogo, volcan_ventas y volcan_despacho.
# Es la misma que usan por defecto los application-mysql.yml (DB_PASSWORD).
MYSQL_APP_PASSWORD=volcan123
# Cambiar si ya tienes otro MySQL ocupando el 3306 (por ejemplo, 3307).
MYSQL_PORT=3306
